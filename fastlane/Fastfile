default_platform(:ios)

platform :ios do
  desc "Push to TestFlight"
  lane :beta do
    # App Store Connect API 認証
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      is_key_content_base64: true
    )

    # ビルド番号の自動インクリメント（日時ベース）
    increment_build_number(
      build_number: Time.now.strftime("%Y%m%d%H%M")
    )

    # アプリのビルド（Xcodeの署名設定をRelease / App Store用に強制上書き）
    build_app(
      scheme: "school_Message",
      export_method: "app-store",
      xcargs: "CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY='Apple Distribution' PROVISIONING_PROFILE_SPECIFIER='SchoolMessage'"
    )

    # TestFlightへアップロード
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
