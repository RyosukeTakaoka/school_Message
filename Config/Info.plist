<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>ja</string>
	<key>CFBundleDisplayName</key>
	<string>School Message</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<!-- 写真・動画・カメラの利用目的.
	     審査で必須であると同時に, ユーザに「なぜ求められているか」を日本語で伝える. -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>友達に送る写真や動画を選ぶために使います。選んだもの以外はアプリから見えません。</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>チャットで受け取った写真や動画を「写真」アプリに保存するために使います。</string>
	<key>NSCameraUsageDescription</key>
	<string>その場で写真や動画を撮ってチャットに送るために使います。</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>動画を撮影するときに音声を録音するために使います。</string>

	<!-- ロック画面に「すれ違い通信 ON / 今日 N 人」を出すため(Live Activity).
	     表示そのものはバックグラウンド実行を与えない. 狙いは
	     「動いているのが見えていれば, アプリを強制終了されにくくなる」こと.
	     Widget Extension が無い間は, 単に表示が出ないだけで害は無い. -->
	<key>NSSupportsLiveActivities</key>
	<true/>

	<!-- すれ違い通信. 近くの端末に自分の名刺を配り, 相手の名刺を読むために使う.
	     位置情報は取得しない. -->
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>すれ違い通信で、近くにいる友達と自動で名刺を交換するために使います。設定で切ることができます。</string>

	<!-- remote-notification: サイレント通知で新着メッセージを取り込み, 復号した本文を通知に出すため.
	     bluetooth-central / bluetooth-peripheral: アプリを閉じている間もすれ違えるようにするため.
	     いずれも Xcode の Signing & Capabilities での操作は不要
	     (Background Modes は Info.plist だけで有効になり, 専用の entitlement を持たない). -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
		<string>bluetooth-central</string>
		<string>bluetooth-peripheral</string>
	</array>

	<!-- iPad はすべての向きに対応する. 机上でも手持ちでも同じように使えるように. -->
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!-- false のままにすることで Split View / Slide Over に対応する. -->
	<key>UIRequiresFullScreen</key>
	<false/>

	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string></string>
	</dict>

	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
	</dict>

	<!-- 輸出コンプライアンス(ITSAppUsesNonExemptEncryption)は意図的に未設定.
	     本アプリはメッセージのエンドツーエンド暗号化を行うため, 単純に
	     false を宣言することはできない. App Store Connect 側で
	     自己分類レポートの要否を確認したうえで設定すること.
	     詳細は docs/SECURITY.md を参照. -->
</dict>
</plist>
